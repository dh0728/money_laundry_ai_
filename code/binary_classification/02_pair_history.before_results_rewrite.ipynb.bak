   ],
   "source": [
    "con = L.connect(threads=8, memory='12GB')\n",
    "currency_codes, format_codes = B.code_tables(con, cfg)\n",
    "PORTS_PATH = B.ensure_ports(con, cfg)               # 있으면 건너뜀\n",
    "tx = B.load_tx(con, cfg)\n",
    "tx = B.attach_parquet(tx, PORTS_PATH, B.PORT_FEATURES)\n",
    "tx.shape"
   ]
  },
