   "id": "27b9e6b6",
   "metadata": {},
   "source": [
    "## 8. 패턴별 recall · degree 층화 — 01 과 비교"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "c140dcbe-5164-484f-8b23-99f94473c83c",
