     "output_type": "execute_result"
    }
   ],
   "source": [
    "val_df = B.val_sample(con, cfg.val_window, cfg.val_neg_rate)        # 검증: 가중 표본 (05 공유)\n",
    "test_df = B.test_full(con, cfg.test_window)                         # 테스트: 구간 전체\n",
    "in_degree = B.recipient_indegree(con, cfg)                           # 분석용\n",
    "con.close()\n",
    "\n",
    "all_edge_ids = tx['edge_id'].to_numpy()\n",
    "val_idx = B.rows_of(all_edge_ids, val_df['edge_id'].to_numpy()); test_idx = B.rows_of(all_edge_ids, test_df['edge_id'].to_numpy())\n",
    "assert (tx['y'].to_numpy()[val_idx] == val_df['y'].to_numpy()).all()\n",
    "del all_edge_ids\n",
    "val_df.shape, test_df.shape"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f7a61ab8",
   "metadata": {},
   "source": [
    "# 트리 모델 (기본 4 + 이번 피처 4)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "294140f3",
   "metadata": {},
   "source": [
    "## 4. LightGBM / XGBoost"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "8abdab9e",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "((102336629, 8), (26808230, 8))"
      ]
     },
     "execution_count": 13,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "results = {}\n",
    "tree_cols = [GNN_EDGE_FEATURES.index(c) for c in TREE_FEATURES]\n",
    "train_mask = in_train\n",
    "X_train = feat_z[train_mask][:, tree_cols]; y_train = tx['y'].to_numpy()[train_mask]\n",
    "X_val, y_val, w_val = feat_z[val_idx][:, tree_cols], val_df['y'].to_numpy(), val_df['w'].to_numpy()\n",
    "X_test = feat_z[test_idx][:, tree_cols]\n",
    "if cfg.smoke:\n",
    "    keep = np.random.default_rng(cfg.seed).choice(len(X_train), min(len(X_train), 200_000), replace=False)\n",
    "    X_train, y_train = X_train[keep], y_train[keep]\n",
    "X_train.shape, X_test.shape"
   ]
  },
  {
   "cell_type": "code",
