   ],
   "source": [
    "import importlib; importlib.reload(B)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "436be09b",
   "metadata": {},
   "outputs": [],
   "source": [
    "pattern_tables, degree_tables = [], []\n",
    "for name in ['lightgbm', 'xgboost', 'gine']:\n",
    "    sc = B.load_scores(OUT_DIR / f'{name}_test_scores.parquet')\n",
    "    pattern_tables.append(B.pattern_recall(sc).assign(model=name))\n",
    "    degree_tables.append(B.degree_stratified(sc, test_df['dst'].to_numpy(), in_degree).assign(model=name))\n",
    "pattern_df, degree_df = pd.concat(pattern_tables), pd.concat(degree_tables)\n",
    "pattern_df.to_csv(OUT_DIR / 'analysis_pattern.csv', encoding='utf-8-sig'); degree_df.to_csv(OUT_DIR / 'analysis_degree.csv', encoding='utf-8-sig')"
   ]
  },
