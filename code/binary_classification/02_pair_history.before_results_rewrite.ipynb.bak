   "source": [
    "in_train = B.window_mask(tx, cfg.train_window)\n",
    "feat_z, znorm_table = B.znorm_features(tx, GNN_EDGE_FEATURES, in_train)     # tx 에서 피처 열은 떨어짐\n",
    "znorm_table"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "94e06008",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "데이터 기간 2022-08-01 ~ 2023-01-12\n",
      "train 2022-08-08:2022-10-02  거래  102,336,629  세탁  110,671  비율 0.108%\n",
      "val   2022-10-03:2022-10-16  거래   24,413,046  세탁   33,795  비율 0.138%\n",
      "test  2022-10-17:2022-10-30  거래   26,808,230  세탁   34,460  비율 0.129%\n"
     ]
    }
   ],
   "source": [
    "print(f\"데이터 기간 {tx['day'].min().date()} ~ {tx['day'].max().date()}\")\n",
    "for name, w in [('train', cfg.train_window), ('val', cfg.val_window), ('test', cfg.test_window)]:\n",
    "    m = B.window_mask(tx, w); assert m.sum() > 0, f'{name} 구간 {w} 에 거래가 없음'\n",
    "    print(f'{name:5s} {w}  거래 {m.sum():>12,}  세탁 {tx.loc[m, \"y\"].sum():>8,}  비율 {tx.loc[m, \"y\"].mean()*100:.3f}%')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "fc232f91",
