   "source": [
    "# 저장\n",
    "cb['matrix'].to_csv(OUT_DIR / 'analysis_confusion.csv')\n",
    "for axis in groups:\n",
    "    cb['fn'][axis].to_csv(OUT_DIR / f'analysis_fn_{axis}.csv'); cb['fp'][axis].to_csv(OUT_DIR / f'analysis_fp_{axis}.csv')"
   ]
  },
