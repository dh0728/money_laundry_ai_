   "source": [
    "# 트리 테스트 점수도 저장 (분석용)\n",
    "for name, model in [('lightgbm', lgb_model), ('xgboost', xgb_model)]:\n",
    "    pd.DataFrame(dict(edge_id=test_df.edge_id, y=test_df.y, score=model.predict_proba(X_test)[:, 1])).to_parquet(OUT_DIR / f'{name}_test_scores.parquet', index=False)\n",
    "del X_train, y_train, X_test; gc.collect()\n",
    "pd.DataFrame({k: v['val'] for k, v in results.items()}).T.round(4)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fb1925d7",
   "metadata": {},
   "source": [
    "# GNN (GINe, 01 과 같은 설정)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "89b064df",
   "metadata": {},
   "source": [
    "## 5. 그래프 — 한 번에 하나만 (bc_lib.GraphStore)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c9e95223",
   "metadata": {},
   "outputs": [],
   "source": [
    "store = B.GraphStore(tx, feat_z, cfg, train_rows=np.flatnonzero(train_mask), val_idx=val_idx, test_idx=test_idx,\n",
    "                     port_cols=[GNN_EDGE_FEATURES.index('in_port'), GNN_EDGE_FEATURES.index('out_port')])\n",
    "del tx, feat_z; B.trim('(tx, feat_z 삭제 후)')\n",
    "store.edge_dim"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8a0c4df9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 배치 하나 꺼내서 모양 확인 — 2048 target 이 서브그래프 하나를 공유, 엣지 피처 10열\n",
    "batch = next(iter(store.use('train')))\n",
    "print('노드', batch['node'].num_nodes, ' to 간선', batch[B.TO].num_edges, ' rev_to 간선', batch[B.REV].num_edges,\n",
    "      ' target', batch[B.TO].edge_label_index.shape[1], ' 양성', int(batch[B.TO].edge_label.sum()),\n",
    "      ' x 열', batch['node'].x.shape[1], ' edge_attr 열', batch[B.TO].edge_attr.shape[1], ' target_attr', tuple(batch.target_attr.shape))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9f507898",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 모델 모양 확인\n",
    "model = B.make_gine(store.edge_dim, cfg, edge_updates=False).to(DEVICE)\n",
    "logits, labels = B.forward_batch(model, batch, DEVICE)\n",
    "print('파라미터', sum(p.numel() for p in model.parameters()), ' 로짓', tuple(logits.shape))\n",
    "del model, batch"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f344d099",
   "metadata": {},
   "source": [
    "## 6. 학습 — GINe"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d440df5b",
   "metadata": {},
   "outputs": [],
   "source": [
    "gine_model, gine_hist = B.train_gnn('gine', store, cfg, val_df, OUT_DIR, DEVICE, edge_updates=False, results=results)\n",
    "results['gine']['val']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "df14561a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 학습 곡선\n",
    "fig, ax = plt.subplots(1, 2, figsize=(11, 3.5))\n",
    "hv = gine_hist.dropna(subset=['AP']); ax[0].plot(hv['epoch'], hv['AP'], marker='o'); ax[1].plot(gine_hist['epoch'], gine_hist['train_loss'])\n",
    "ax[0].set_title('val AP'); ax[1].set_title('train loss'); ax[0].set_xlabel('epoch'); ax[1].set_xlabel('epoch')\n",
    "plt.tight_layout(); plt.savefig(OUT_DIR / 'curves.png', dpi=120); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d36d1236",
   "metadata": {},
   "source": [
    "## 7. 테스트 — 구간 전체"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "34bbcfe7",
   "metadata": {},
   "outputs": [],
   "source": [
    "gine_score = B.test_gnn('gine', store, cfg, test_df, OUT_DIR, DEVICE, edge_updates=False, results=results)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fa7d150d",
   "metadata": {},
   "source": [
    "# 결과"
   ]
  },
  {
