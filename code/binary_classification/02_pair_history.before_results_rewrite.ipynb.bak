   "source": [
    "# 수신 계좌 degree 구간별 AP — 허브 구간이 달라졌나\n",
    "prev_d = pd.read_csv(Path.cwd() / 'results' / cfg.dataset / PREV_RUN / 'analysis_degree.csv', index_col=0)\n",
    "pd.DataFrame({\n",
    "    '01 gine_basic AP': prev_d[prev_d.model == 'gine_basic']['AP'],\n",
    "    '02 gine AP': degree_df[degree_df.model == 'gine']['AP'],\n",
    "    '02 gine F1': degree_df[degree_df.model == 'gine']['F1'],\n",
    "    'n_pos': degree_df[degree_df.model == 'gine']['n_pos'],\n",
    "}).round(4)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 38,
   "id": "699d82f5-62ec-4b61-86ee-ea965a54c636",
   "metadata": {},
   "outputs": [
